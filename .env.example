# 电商挂网监控公开版配置模板
# 所有敏感值默认留空，请在自己的私有环境中填写。

# 基础环境
ENVIRONMENT=development
LOG_LEVEL=INFO
DRY_RUN=true

# 数据库
DATABASE_URL=sqlite:///./data/ecommerce_monitor.db

# 平台开关
PLATFORM_A_ENABLED=true
PLATFORM_B_ENABLED=true
PLATFORM_C_ENABLED=false

# 巡查计划
PRODUCT_LIBRARY_SOURCE=examples/product_library.sample.csv
CUSTOMER_LIBRARY_SOURCE=examples/customer_library.sample.csv
STAFF_ROUTE_SOURCE=examples/staff_routes.sample.csv

# 访问节奏
GLOBAL_MIN_DELAY_SECONDS=10
GLOBAL_MAX_DELAY_SECONDS=30
MAX_ITEMS_PER_PLAN=0

# 外部表格系统
EXTERNAL_TABLE_ENABLED=false
EXTERNAL_TABLE_APP_TOKEN=
EXTERNAL_TABLE_ID=
EXTERNAL_CUSTOMER_TABLE_APP_TOKEN=
EXTERNAL_CUSTOMER_TABLE_ID=
EXTERNAL_STAFF_TABLE_APP_TOKEN=
EXTERNAL_STAFF_TABLE_ID=

# 通知系统
NOTIFICATION_ENABLED=false
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_BOT_APP_ID=
NOTIFICATION_BOT_APP_SECRET=
NOTIFICATION_TARGET_CHAT_ID=
NOTIFICATION_ADMIN_IDS=
NOTIFICATION_STAFF_ID_MAP=

# AI 辅助能力
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=

# 运行产物
RUNS_DIR=runs
LOGS_DIR=logs
EVIDENCE_DIR=evidence
EXPORTS_DIR=exports
